# Mealie MCP server configuration
# Each request runs as the gateway-authenticated user, with that user's Mealie
# token read from Authentik. There is no shared Mealie API key.

# The base URL of your Mealie instance (including protocol and port if needed)
MEALIE_BASE_URL=https://your-mealie-instance.com

# Authentik base URL and the API token of a read-only service account
# (needs permission to view users and their attributes)
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_TOKEN=your-authentik-service-account-token

# User attribute holding each user's Mealie API token
AUTHENTIK_TOKEN_ATTRIBUTE=mealie_token

# Header the gateway fills with the verified username (preferred_username)
MCP_USER_HEADER=X-User

# Seconds to cache a user's token (0-3600)
MEALIE_TOKEN_CACHE_TTL=120

LOG_LEVEL=INFO

# Opt in to the AI import tool (Mealie 3.23.0+ with a default AI provider).
# Only true/false are accepted. Restart the server after changing this.
MEALIE_ENABLE_AI_IMPORT=false

# Transport mode: "streamable-http" (default) or legacy "sse"
MCP_TRANSPORT=streamable-http

# Bind address and port. Keep the server reachable only through the gateway.
MCP_HOST=127.0.0.1
MCP_PORT=8765
